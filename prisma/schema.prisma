// Prisma Schema for ReadToChange
// Database is configured for SQLite in local development (zero-config, file:./dev.db)
// In production, change provider to "postgresql" and set DATABASE_URL in environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. User: Represents a Telegram user using the app
model User {
  id              String           @id @default(uuid())
  telegramId      String           @unique
  username        String?
  firstName       String?
  lastName        String?
  dailyTarget     Int              @default(15) // Minutes per day (10, 15, 20, 30)
  reminderTime    String           @default("20:30") // HH:mm format
  streakDays      Int              @default(0)
  lastReadAt      DateTime?
  activeBookId    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  userGoals       UserGoal[]
  userBooks       UserBook[]
  readingSessions ReadingSession[]
  actions         UserAction[]
}

// 2. Goal: Growth categories (Discipline, Focus, Productivity, etc.)
model Goal {
  id          String     @id // e.g. "discipline", "focus"
  label       String
  description String
  createdAt   DateTime   @default(now())

  userGoals   UserGoal[]
}

// 3. UserGoal: Many-to-many relationship between User and Goal
model UserGoal {
  id        String   @id @default(uuid())
  userId    String
  goalId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([userId, goalId])
}

// 4. Book: Curated catalog books or user-tracked personal books
model Book {
  id              String           @id // Slug or UUID
  title           String
  author          String
  totalPages      Int              @default(250)
  coverUrl        String?
  growthCategory  String           @default("Personal Growth")
  aiHook          String           @default("Small daily inputs lead to lifelong transformation.")
  whyThisBook     String           @default("A foundational guide to mastering habits and personal discipline.")
  mascotTake      String?
  summary         String           @default("")
  keyIdeasJson    String           @default("[]") // JSON stringified array of strings
  previewUrl      String?
  isPublicDomain  Boolean          @default(false)
  isCustom        Boolean          @default(false) // True if user tracked own book
  createdByUserId String?
  createdAt       DateTime         @default(now())

  userBooks       UserBook[]
  readingSessions ReadingSession[]
  actions         UserAction[]
}

// 5. UserBook: Status and reading progress of a user with a specific book
model UserBook {
  id          String    @id @default(uuid())
  userId      String
  bookId      String
  status      String    @default("READING") // "WANT_TO_READ" | "READING" | "FINISHED"
  currentPage Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// 6. ReadingSession: Log of every focused reading session
model ReadingSession {
  id                 String   @id @default(uuid())
  userId             String
  bookId             String
  durationMinutes    Int
  pagesRead          Int
  takeaway           String?
  reflectionQuestion String   @default("What stood out to you in today's reading?")
  reflectionAnswer   String?
  actionItem         String?
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book               Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// 7. UserAction: 1 concrete action item generated after reflection
model UserAction {
  id          String    @id @default(uuid())
  userId      String
  bookId      String?
  description String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)
}

// 8. Feedback: Direct user comments, book requests, and feedback
model Feedback {
  id         String   @id @default(uuid())
  userId     String?
  telegramId String?
  username   String?
  firstName  String?
  message    String
  source     String   @default("telegram") // "telegram" | "webapp"
  createdAt  DateTime @default(now())
}

